<!DOCTYPE html>
<html lang="pt-br" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documentação - ViaDetran</title>
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card bg-dark border-secondary">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4">Filtrar Documentação</h4>
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="filtroNomePagina" class="form-label">Nome da Página</label>
                                    <input type="text" class="form-control" id="filtroNomePagina" placeholder="Ex: MenuSistema">
                                </div>
                                <div class="col-md-6">
                                    <label for="filtroSistema" class="form-label">Sistema</label>
                                    <select class="form-select" id="filtroSistema">
                                        <option value="" selected>Selecione...</option>
                                        <option value="AreaRestrita">AreaRestrita</option>
                                        <option value="Publico">Publico</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="filtroProcedure" class="form-label">Nome da Procedure</label>
                                    <input type="text" class="form-control" id="filtroProcedure" placeholder="Ex: MontaMenu">
                                </div>
                                <div class="col-md-6">
                                    <label for="filtroTabela" class="form-label">Nome da Tabela</label>
                                    <input type="text" class="form-control" id="filtroTabela" placeholder="Ex: Formulario">
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="reset" class="btn btn-outline-secondary">Limpar</button>
                                <button type="submit" class="btn btn-primary">Filtrar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>